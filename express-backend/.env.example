NODE_ENV=development||production

# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

#randomized string to hash the otp before storing in db
OTP_HASH_SECRET=replace with a long randomly generated string

#jwt secret to sign and send a token after the otp is verified which the frontend uses to complete the registration for the user
EMAIL_VERIFICATION_SECRET=replace with a long randomly generated string

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM="ShopCo <no-reply@example.com>"


# Secret used to sign JWTs
# generate one in terminal: node -p "crypto.randomBytes(64).toString('hex')"
JWT_SECRET=replace with a long randomly generated string

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000
