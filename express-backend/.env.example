# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Secret used to sign JWTs — use a long random string in production
# e.g. generate one with: node -p "crypto.randomBytes(64).toString('hex')"
JWT_SECRET=replace with a long randomly generated string

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:3000
